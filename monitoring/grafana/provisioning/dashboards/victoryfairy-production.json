    },
    {
      "type": "timeseries",
      "title": "SQL p95 latency by operation",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(victoryfairy_database_query_seconds_bucket{job=\"victoryfairy-api\"}[$__rate_interval])))", "legendFormat": "{{operation}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "SQL execution rate and slow queries (>1s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (operation, outcome) (rate(victoryfairy_database_query_seconds_count{job=\"victoryfairy-api\"}[$__rate_interval]))", "legendFormat": "{{operation}} {{outcome}}", "refId": "A" },
        { "expr": "sum by (operation) (rate(victoryfairy_database_query_seconds_count{job=\"victoryfairy-api\"}[$__rate_interval])) - sum by (operation) (rate(victoryfairy_database_query_seconds_bucket{job=\"victoryfairy-api\",le=\"1.0\"}[$__rate_interval]))", "legendFormat": "{{operation}} >1s", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Hikari connection pool",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"victoryfairy-api\"}", "legendFormat": "active", "refId": "A" },
        { "expr": "hikaricp_connections_idle{job=\"victoryfairy-api\"}", "legendFormat": "idle", "refId": "B" },
        { "expr": "hikaricp_connections_pending{job=\"victoryfairy-api\"}", "legendFormat": "pending", "refId": "C" },
        { "expr": "hikaricp_connections_max{job=\"victoryfairy-api\"}", "legendFormat": "max", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "JVM heap and GC pause",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"victoryfairy-api\",area=\"heap\"})", "legendFormat": "heap used", "refId": "A" },
        { "expr": "sum(jvm_memory_max_bytes{job=\"victoryfairy-api\",area=\"heap\"})", "legendFormat": "heap max", "refId": "B" },
        { "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"victoryfairy-api\"}[$__rate_interval]))", "legendFormat": "GC pause / sec", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 12
    },
