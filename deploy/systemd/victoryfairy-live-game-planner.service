[Unit]
Description=Plan today's live KBO game sync
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/victoryfairy
RuntimeDirectory=victoryfairy-game-sync
RuntimeDirectoryPreserve=yes
ExecStart=/opt/victoryfairy/bin/schedule-live-game.sh plan
TimeoutStartSec=40min
Restart=on-failure
RestartSec=1min
