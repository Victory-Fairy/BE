[Unit]
Description=VictoryFairy game data sync (%i days ago)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/victoryfairy
Environment=TZ=Asia/Seoul
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=SPRING_DATA_REDIS_HOST=127.0.0.1
Environment="STORAGE_DATASOURCE_CORE_JDBC_URL=jdbc:mysql://victory-fairy-prod.cdcisgyewras.ap-northeast-2.rds.amazonaws.com:3306/victoryFairy?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul"
Environment=STORAGE_DATASOURCE_CORE_USERNAME=admin
Environment=WEBHOOK_SLACK_URL=http://127.0.0.1/disabled
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/victoryfairy/playwright
Environment=PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
Environment="SPRING_CONFIG_ADDITIONAL_LOCATION=file:/opt/victoryfairy/config/craw/"
EnvironmentFile=/opt/victoryfairy/secrets.env
RuntimeDirectory=victoryfairy-game-sync
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/flock --nonblock /run/victoryfairy-game-sync/job.lock /usr/bin/java -Xms64m -Xmx384m -jar /opt/victoryfairy/apps/core-craw.jar --spring.main.web-application-type=none --game-recovery.enabled=true --game-recovery.days-ago=%i --game-recovery.dry-run=false
Nice=10
MemoryMax=700M
MemorySwapMax=1G
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
